<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cinépolis</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background-color: #f4f4f4; color: #333; }
        header { background-color: #002244; color: #F2A900; text-align: center; padding: 15px; }
        nav { background-color: #00152B; text-align: center; padding: 10px; }
        nav a { color: white; margin: 0 10px; text-decoration: none; font-weight: bold; }
        main { width: 80%; max-width: 800px; margin: 20px auto; background: white; padding: 20px; border-radius: 8px; }
        section { margin-bottom: 25px; }
        h2 { color: #002244; border-bottom: 2px solid #F2A900; padding-bottom: 5px; }
        .cartelera { display: flex; gap: 15px; justify-content: center; }
        .pelicula { border: 1px solid #ccc; padding: 10px; text-align: center; width: 180px; border-radius: 5px; }
        .pelicula img { width: 100%; height: 220px; object-fit: cover; }
        .btn-comprar { background-color: #F2A900; color: #002244; border: none; padding: 8px 12px; font-weight: bold; border-radius: 4px; cursor: pointer; }
        form { background: #e6ecf2; padding: 15px; border-radius: 5px; max-width: 300px; margin: 0 auto; }
        label { display: block; margin-top: 10px; font-weight: bold; }
        input { width: 100%; padding: 8px; margin-top: 5px; box-sizing: border-box; }
        .btn-ingresar { background-color: #002244; color: white; border: none; padding: 10px; margin-top: 15px; width: 100%; font-weight: bold; border-radius: 4px; cursor: pointer; }
        footer { background-color: #002244; color: white; text-align: center; padding: 10px; font-size: 14px; }
    </style>
</head>
<body>

    <!-- 1. ENCABEZADO Y NAVEGACIÓN -->
    <header>
        <h1>Cinépolis</h1>
    </header>
    <nav>
        <a href="#cartelera">En Cartelera</a>
        <a href="#estrenos">Próximos Estrenos</a>
        <a href="#club">Club Cinépolis</a>
    </nav>

    <main>
        <!-- 2. EN CARTELERA -->
        <section id="cartelera">
            <h2>En Cartelera</h2>
            <div class="cartelera">
                <div class="pelicula">
                    <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=200" alt="Dune">
                    <h3>Dune</h3>
                    <p>Clasificación: B</p>
                    <button class="btn-comprar">Comprar</button>
                </div>
                <div class="pelicula">
                    <img src="https://images.unsplash.com/photo-1509198397868-475647b2a1e5?w=200" alt="Batman">
                    <h3>Batman</h3>
                    <p>Clasificación: B15</p>
                    <button class="btn-comprar">Comprar</button>
                </div>
                <div class="pelicula">
                    <img src="https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?w=200" alt="Spider-Man">
                    <h3>Spider-Man</h3>
                    <p>Clasificación: A</p>
                    <button class="btn-comprar">Comprar</button>
                </div>
            </div>
        </section>

        <!-- 3. PRÓXIMOS ESTRENOS -->
        <section id="estrenos">
            <h2>Próximos Estrenos</h2>
            <ul>
                <li><strong>Deadpool & Wolverine</strong> - Próximamente</li>
                <li><strong>Kung Fu Panda 4</strong> - Próximamente</li>
                <li><strong>Gladiador II</strong> - Próximamente</li>
            </ul>
        </section>


        <section id="club">
            <h2>Club Cinépolis</h2>
            <form>
                <label>Nombre:</label>
                <input type="text" required>
                
                <label>Número de Tarjeta:</label>
                <input type="text" placeholder="1234 5678 9012" required>
                
                <label>Correo electronico:</label>
                <input type="email" placeholder="ejemplo@correo.com" required>
                
                <label>Contraseña:</label>
                <input type="password" placeholder="******" required>
                
                <button type="submit" class="btn-ingresar">Ingresar</button>
            </form>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 Cinépolis | Contacto: ayuda@cinepolis.com</p>
        <p>- Ramirez Gomez Maria Camila - 5-I - 24308051280627 -</p>
    </footer>

</body>
</html>
